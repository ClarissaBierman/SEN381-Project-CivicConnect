# Copy to .env (never commit .env) and fill in the values.

# The application connects as the limited login role created by the build script / V3 migration.
DB_URL=jdbc:postgresql://<host>:5432/postgres
DB_USERNAME=civicconnect_app
DB_PASSWORD=

# Flyway migrations run as the schema owner, because they ALTER tables and GRANT permissions.
# On Supabase this is the "postgres" user (with the pooler: postgres.<project-ref>).
FLYWAY_USER=postgres
FLYWAY_PASSWORD=

# At least 32 characters, random
JWT_SECRET=

# Optional
# DB_SWITCH_ROLES=true
# SHOW_SQL=false
