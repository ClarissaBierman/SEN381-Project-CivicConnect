" vertex="1"><mxGeometry x="0" y="186" width="364" height="26" as="geometry" /></mxCell><mxCell id="k-179" value="FK" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" parent="r-audit_entry-emp_id" vertex="1"><mxGeometry x="0" y="0" width="44" height="26" as="geometry" /></mxCell><mxCell id="n-180" value="emp_id" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;html=1;fontFamily=Helvetica;" parent="r-audit_entry-emp_id" vertex="1"><mxGeometry x="44" y="0" width="170" height="26" as="geometry" /></mxCell><mxCell id="y-181" value="BIGINT (null)" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;html=1;fontColor=#666666;fontSize=11;fontFamily=Helvetica;" parent="r-audit_entry-emp_id" vertex="1"><mxGeometry x="214" y="0" width="150" height="26" as="geometry" /></mxCell><mxCell id="r-audit_entry-client_id" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontFamily=Helvetica;" parent="t-audit_entry" vertex="1"><mxGeometry x="0" y="212" width="364" height="26" as="geometry" /></mxCell><mxCell id="k-182" value="FK" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" parent="r-audit_entry-client_id" vertex="1"><mxGeometry x="0" y="0" width="44" height="26" as="geometry" /></mxCell><mxCell id="n-183" value="client_id" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;html=1;fontFamily=Helvetica;" parent="r-audit_entry-client_id" vertex="1"><mxGeometry x="44" y="0" width="170" height="26" as="geometry" /></mxCell><mxCell id="y-184" value="BIGINT (null)" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;html=1;fontColor=#666666;fontSize=11;fontFamily=Helvetica;" parent="r-audit_entry-client_id" vertex="1"><mxGeometry x="214" y="0" width="150" height="26" as="geometry" /></mxCell><mxCell id="r-audit_entry-changed_at" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;fontFamily=Helvetica;" parent="t-audit_entry" vertex="1"><mxGeometry x="0" y="238" width="364" height="26" as="geometry" /></mxCell><mxCell id="k-185" value="" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;" parent="r-audit_entry-changed_at" vertex="1"><mxGeometry x="0" y="0" width="44" height="26" as="geometry" /></mxCell><mxCell id="n-186" value="changed_at" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;html=1;fontFamily=Helvetica;" parent="r-audit_entry-changed_at" vertex="1"><mxGeometry x="44" y="0" width="170" height="26" as="geometry" /></mxCell><mxCell id="y-187" value="TIMESTAMP" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;html=1;fontColor=#666666;fontSize=11;fontFamily=Helvetica;" parent="r-audit_entry-changed_at" vertex="1"><mxGeometry x="214" y="0" width="150" height="26" as="geometry" /></mxCell><mxCell id="v-audit_log" value="&lt;b&gt;audit_log&lt;/b&gt; (VIEW, V6)&lt;br&gt;Same columns as audit_entry; client name, email, phone and date of birth masked. Staff see only request, request_handler and comment rows. Staff and management read this view, not audit_entry." style="rounded=1;whiteSpace=wrap;html=1;dashed=1;align=left;spacingLeft=8;spacingRight=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="80" y="844" width="364" height="92" as="geometry" /></mxCell><mxCell id="title" value="&lt;b style=&quot;font-size:18px&quot;&gt;CivicConnect ERD v3&lt;/b&gt; - physical schema after Flyway V1 to V7 (schema civicconnect, PostgreSQL 17), 16/10/2026" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="80" y="20" width="1200" height="36" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Notation&lt;/b&gt; (crow's foot)&lt;br&gt;Each line runs from the parent's primary key to the child's foreign key.&lt;br&gt;| at the parent = exactly one (FK NOT NULL); o| = zero or one (FK nullable).&lt;br&gt;o&amp;lt; at the child = zero or many.&lt;br&gt;PK primary key, FK foreign key, UQ unique; columns are NOT NULL unless marked (null)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="80" y="986" width="364" height="140" as="geometry" /></mxCell><mxCell id="rules" value="&lt;b&gt;Rules the lines do not show&lt;/b&gt;&lt;br&gt;- request.status: NEW, ASSIGNED, IN_PROGRESS, RESOLVED, CLOSED, REJECTED; closed_at is set exactly when CLOSED or REJECTED (chk_request_closed_at).&lt;br&gt;- request.priority: LOW, MEDIUM, HIGH or null (V4). employee.role: STAFF or MANAGEMENT.&lt;br&gt;- request.ref_num: CC-yyyy-nnnnnn from sequence request_ref_seq.&lt;br&gt;- request_handler: one active handler per request (unique index ux_request_handler_active WHERE unassigned_at IS NULL); earlier handlers stay as history; unassigned_at &amp;gt;= assigned_at.&lt;br&gt;- handler_category: (emp_id, cat_id) unique - the categories a staff member covers (FR-005).&lt;br&gt;- audit_entry: written by the trigger audit_row_change on client, employee, category, handler_category, request, request_handler and comment (record_id = the changed row's key, no FK); at most one actor (chk_audit_one_actor). audit_entry and comment are append-only.&lt;br&gt;- Row level security on client, request, comment and employee (V6)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1"><mxGeometry x="664" y="986" width="948" height="140" as="geometry" /></mxCell><mxCell id="e-client-request-requester_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontFamily=Helvetica;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=14;endSize=14;sourcePerimeterSpacing=0;targetPerimeterSpacing=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r-client-client_id" target="r-request-requester_id"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="534" y="123.0" /><mxPoint x="534" y="201.0" /></Array></mxGeometry></mxCell><mxCell id="e-client-audit_entry-client_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontFamily=Helvetica;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=14;endSize=14;sourcePerimeterSpacing=0;targetPerimeterSpacing=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r-client-client_id" target="r-audit_entry-client_id"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="123.0" /><mxPoint x="40" y="745.0" /></Array></mxGeometry></mxCell><mxCell id="e-employee-audit_entry-emp_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;fontFamily=Helvetica;startArrow=ERzeroToOne;endArrow=ERzeroToMany;startFill=0;endFill=0;startSize=14;endSize=14;sourcePerimeterSpacing=0;t